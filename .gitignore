node_modules/
dist/
.astro/
.vercel/
.wrangler/
.tmp/

.env
.env.*
!.env.example

data/snapshots/*.json
!data/snapshots/.gitkeep

# Client profiles are runtime data on the production volume (they carry coordinator
# email lists and uploaded-logo data URIs) — never committed, never touched by deploys.
data/clients/*.json
!data/clients/.gitkeep

# Seller Market Update: monthly board statistics cache and the exposure ledger —
# runtime data on the volume, rebuilt on demand.
data/market/*.json
!data/market/.gitkeep

# Listing website orders: runtime data on the volume (Stripe and CRM are the records
# of record); they carry purchaser emails and agreement evidence.
data/orders/*.json
!data/orders/.gitkeep

*.log

.claude/
.codex-remote-attachments/
