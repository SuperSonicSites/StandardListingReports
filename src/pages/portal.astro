---
// The first page after sign-in: pick a destination. A client email sees the
// clients that list it (usually one); an admin sees every client.
import AppLayout from "../layouts/AppLayout.astro";
import HubLogo from "../components/HubLogo.astro";
import Toast from "../components/Toast.astro";
import { emailMatches, isAdminEmail, sessionEmail } from "../lib/auth";
import { listClients } from "../lib/storage";
import { takeFlash } from "../lib/flash";
import { listingSitesEnabled } from "../lib/stripe";

const email = sessionEmail(Astro.request) ?? "";
const admin = isAdminEmail(email);
const clients = (await listClients()).filter((client) => admin || emailMatches(email, client.emails));
const flash = takeFlash(Astro.cookies);
const single = clients.length === 1 ? clients[0] : undefined;
// Listing websites ship dark: the row is always visible, clickable only once the
// server flag is on and the client is set up for it.
const sitesLive = listingSitesEnabled();

// Layout: one row of primary actions (what a coordinator does for a listing), then
// slim secondary rows for the analytics link and services that aren't actions yet.
// No step numbers — these are destinations, not a sequence.
const arrow =
  '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const icons = {
  ads: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 10v4a1 1 0 0 0 1 1h3l7 4V5L8 9H5a1 1 0 0 0-1 1Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M18.5 9.5a3.5 3.5 0 0 1 0 5M9 15l1.2 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
  report:
    '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 3h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 16.5v-3m3.5 3v-6m3.5 6v-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
  market:
    '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 19h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M6 15l4-4.5 3 3 5-6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 7h3v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  site: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 9h18M8 13h5m-5 3h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
  dashboard:
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="3.5" width="7.5" height="9.5" rx="1" stroke="currentColor" stroke-width="1.8"/><rect x="13" y="3.5" width="7.5" height="5.5" rx="1" stroke="currentColor" stroke-width="1.8"/><rect x="13" y="11" width="7.5" height="9.5" rx="1" stroke="currentColor" stroke-width="1.8"/><rect x="3.5" y="15" width="7.5" height="5.5" rx="1" stroke="currentColor" stroke-width="1.8"/></svg>'
};
---

<AppLayout title="Portal | Supersonic Realtor Hub" className="hub-body">
  <header class="hub-bar">
    <HubLogo />
    <div class="hub-bar-user">
      {admin && <a class="hub-text-link" href="/">Admin dashboard</a>}
      <span class="hub-bar-email" title={email}>{email}</span>
      <form method="post" action="/api/logout">
        <button type="submit" class="hub-text-link">Sign out</button>
      </form>
    </div>
  </header>

  <main class="hub-portal reveal">
    <p class="hub-eyebrow is-red has-line">Realtor marketing portal</p>
    <h1 class="hub-h1">
      Welcome back{single ? `, ${single.name}` : ""}.
    </h1>
    <p class="hub-sub" style="max-width: 520px">
      {
        clients.length
          ? "Choose where you’re headed today."
          : admin
            ? "No clients yet."
            : "This email isn’t linked to a client yet."
      }
    </p>

    {
      clients.length === 0 && admin && (
        <a class="hub-button is-secondary" style="display: inline-flex" href="/admin/clients/new">
          Create the first client
        </a>
      )
    }

    {
      clients.length === 0 && !admin && (
        <div class="hub-privacy" style="max-width: 520px">
          <strong><span class="hub-diamond" aria-hidden="true"></span>Let’s fix that.</strong>
          <span>
            Email{" "}
            <a href="mailto:hello@supersonicsites.com">hello@supersonicsites.com</a>{" "}
            from this address and we’ll connect it to your team.
          </span>
        </div>
      )
    }

    {
      clients.map((client) => (
        <section class="hub-client" aria-label={client.name}>
          {!single && <h2 class="hub-client-name">{client.name}</h2>}
          <p class="hub-group-label">For your listings</p>
          <div class="hub-options">
            {client.zoho_account_id ? (
              <a class="hub-option" href={`/c/${client.slug}/ads`}>
                <span class="hub-option-top">
                  <span class="hub-option-icon" aria-hidden="true"><Fragment set:html={icons.ads} /></span>
                </span>
                <span class="hub-option-title">Submit Listing Ads</span>
                <span class="hub-option-text">Send us a new listing and we’ll launch its ad campaign.</span>
                <span class="hub-option-cta">
                  Submit a listing ad
                  <Fragment set:html={arrow} />
                </span>
              </a>
            ) : (
              <div class="hub-option is-unavailable" aria-disabled="true">
                <span class="hub-option-top">
                  <span class="hub-option-icon" aria-hidden="true"><Fragment set:html={icons.ads} /></span>
                </span>
                <span class="hub-option-title">Submit Listing Ads</span>
                <span class="hub-option-text">
                  Not connected for your team yet. Email{" "}
                  <a href="mailto:hello@supersonicsites.com">hello@supersonicsites.com</a> and we’ll set it up.
                </span>
                <span class="hub-option-cta">Not set up yet</span>
              </div>
            )}

            <a class="hub-option" href={`/c/${client.slug}/`}>
              <span class="hub-option-top">
                <span class="hub-option-icon" aria-hidden="true"><Fragment set:html={icons.report} /></span>
              </span>
              <span class="hub-option-title">Listing Report</span>
              <span class="hub-option-text">After launch: show the seller what the marketing did, in one branded PDF.</span>
              <span class="hub-option-cta">
                Create a report
                <Fragment set:html={arrow} />
              </span>
            </a>

            <a class="hub-option" href={`/c/${client.slug}/?type=market`}>
              <span class="hub-option-top">
                <span class="hub-option-icon" aria-hidden="true"><Fragment set:html={icons.market} /></span>
              </span>
              <span class="hub-option-title">Seller Market Update</span>
              <span class="hub-option-text">When the seller asks why it isn’t selling: this month’s market next to your listing’s exposure.</span>
              <span class="hub-option-cta">
                Create a market update
                <Fragment set:html={arrow} />
              </span>
            </a>
          </div>

          <div class="hub-secondary">
            {client.dashboard_url && (
              <a class="hub-row" href={client.dashboard_url}>
                <span class="hub-row-icon" aria-hidden="true"><Fragment set:html={icons.dashboard} /></span>
                <span class="hub-row-text">
                  <strong>Dashboard</strong>
                  All your analytics in one place: website traffic, social media, and more.
                </span>
                <span class="hub-row-end" aria-hidden="true"><Fragment set:html={arrow} /></span>
              </a>
            )}

            {sitesLive && client.zoho_account_id && client.portfolio_host ? (
              <a class="hub-row" href={`/c/${client.slug}/site`}>
                <span class="hub-row-icon" aria-hidden="true"><Fragment set:html={icons.site} /></span>
                <span class="hub-row-text">
                  <strong>Order a Listing Website</strong>
                  A page for one listing or a whole development on {client.portfolio_host}. $599, hosting included for a year.
                </span>
                <span class="hub-row-end" aria-hidden="true"><Fragment set:html={arrow} /></span>
              </a>
            ) : (
              <div class="hub-row is-unavailable" aria-disabled="true">
                <span class="hub-row-icon" aria-hidden="true"><Fragment set:html={icons.site} /></span>
                <span class="hub-row-text">
                  <strong>Listing Websites</strong>
                  A page for one listing or a whole development, on your own portfolio site.
                </span>
                <span class="hub-row-badge">Coming soon</span>
              </div>
            )}
          </div>
        </section>
      ))
    }

    <div class="hub-help" style="margin-top: 40px">
      <p>Need a hand? We’re friendly.</p>
      <p>
        <a href="tel:+18883212666">1-888-321-2666</a>
        <span aria-hidden="true">•</span>
        <a href="mailto:hello@supersonicsites.com">hello@supersonicsites.com</a>
      </p>
    </div>
  </main>

  <Toast message={flash} />
</AppLayout>
