# Meta System User token (master Business Manager). Server-side only, never exposed to the browser.
META_SYSTEM_USER_TOKEN=

# Rybbit org-scoped API key. Server-side only.
RYBBIT_API_KEY=

# Rybbit API base URL. Defaults to https://app.rybbit.io if unset.
RYBBIT_API_URL=

# Local Chrome/Edge executable for PDF generation, if not in a standard install location.
CHROME_PATH=

# --- Sign-in (magic links, no passwords) ---------------------------------------
# Long random string used to sign sign-in links and session cookies. Required in
# production (sign-in fails closed without it); `npm run dev` uses a throwaway key.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Agency admin addresses (comma-separated). These open the admin area and every
# client workspace. Defaults to dev@supersonicsites.com when unset. Client
# coordinators are listed per client in the admin form.
ADMIN_EMAILS=dev@supersonicsites.com

# Public base URL used in sign-in links. Defaults to https://supersonicrealtors.com;
# set to http://127.0.0.1:4321 for local dev.
APP_URL=

# Resend API key for sending sign-in links. In dev, leaving it blank prints the
# link to the server console instead of emailing it.
RESEND_API_KEY=

# Sender shown on sign-in emails — must be on a domain verified in Resend.
# Defaults to "Supersonic Realtors <login@supersonicrealtors.com>".
MAIL_FROM=

# Set to 1 to make "Pull data" return fabricated demo numbers (source: "mock") when no
# API credentials are configured. Leave unset in production: without it, a missing
# credential degrades to a "configure or enter manually" warning instead of fake data.
DEMO_MODE=

# NOTE: .env is only read by `npm run dev` (Vite loads it at startup — restart after edits).
# The built server (`npm run start` / `npm run preview`) does NOT load .env; set real
# environment variables on the host (e.g. Railway service variables) instead.
