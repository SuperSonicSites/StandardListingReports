---
import AppLayout from "../layouts/AppLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Toast from "../components/Toast.astro";
import { listClients, listOrders } from "../lib/storage";
import { takeFlash } from "../lib/flash";
import { pendingOperations } from "../lib/site-order-fulfil";
import { marketStatus } from "../lib/market";
import { monthLabel } from "../lib/market-rules";

const clients = await listClients();
// Seller Market Update: what each market has cached and how its last fetch went.
const markets = await marketStatus();
const flash = takeFlash(Astro.cookies);
const count = clients.length;
// Listing website orders: a recovery panel, not a production board (that is CRM).
const orders = (await listOrders()).slice(0, 50);
const fmt = (iso: string) => (iso ? iso.slice(0, 16).replace("T", " ") : "—");

const initialsOf = (name: string) =>
  name
    .trim()
    .split(/\s+/)
    .map((word) => word[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
---

<AppLayout title="Seller Report Generator | Supersonic" className="app-body">
  <SiteHeader>
    <a class="nav-link" href="/admin/clients/new">New client</a>
  </SiteHeader>

  <main class="app-shell">
    <section class="app-hero">
      <div style="max-width: 560px">
        <p class="eyebrow">Seller report engine</p>
        <h1 style="font-size: clamp(1.55rem, 3.2vw, 2.05rem)">
          Seller Report Generator
        </h1>
        {
          count === 0 && (
            <p>
              Capture report details, freeze the numbers into a snapshot, and
              render a branded seller report ready to download as a PDF.
            </p>
          )
        }
      </div>
    </section>

    <section class="panel">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Clients</p>
          <h2 style="display: flex; align-items: center; gap: 10px">
            Your clients
            <span class="pill">{count} {count === 1 ? "client" : "clients"}</span>
          </h2>
        </div>
        {
          count > 6 && (
            <div class="dash-search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <circle cx="11" cy="11" r="7" stroke="#64748b" stroke-width="1.75" />
                <path
                  d="m20 20-3.2-3.2"
                  stroke="#64748b"
                  stroke-width="1.75"
                  stroke-linecap="round"
                />
              </svg>
              <input
                type="search"
                data-client-search
                placeholder="Search clients…"
                aria-label="Search clients"
              />
            </div>
          )
        }
      </div>

      {
        count > 0 ? (
          <div class="client-grid" data-client-grid>
            {clients.map((client) => (
              <article class="ccard" data-client-name={client.name}>
                <div class="ccard-logo" style={`color: ${client.brand_accent}`}>
                  {initialsOf(client.name)}
                </div>
                <div class="ccard-body">
                  <h3>{client.name}</h3>
                  <p>{client.footer_text}</p>
                  <div class="ccard-actions">
                    <a
                      class="button secondary sm ccard-open"
                      href={`/c/${client.slug}/`}
                      style="border-color: var(--ss-accent); color: var(--ss-accent-ink)"
                      aria-label={`Open report form for ${client.name}`}
                    >
                      Open report form
                    </a>
                    <a
                      class="button ghost sm ccard-edit"
                      href={`/admin/clients/${client.slug}/edit`}
                      aria-label={`Edit ${client.name}`}
                    >
                      Edit
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <img
              src="/assets/supersonic-logo.png"
              alt="Supersonic"
              width="200"
              height="118"
              style="width: 118px; height: auto; opacity: 0.92"
            />
            <div>
              <strong style="font-size: 1.1rem">No clients yet</strong>
              <p style="max-width: 380px; line-height: 1.6">
                Create your first client to generate a branded report form they
                can fill in.
              </p>
            </div>
            <a class="button primary" href="/admin/clients/new">
              Create your first client
            </a>
          </div>
        )
      }
    </section>

    <section class="panel" style="margin-top: 24px">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Seller Market Update</p>
          <h2>Market statistics</h2>
        </div>
        <form method="post" action="/api/market-refresh">
          <button type="submit" class="button secondary sm">Refresh market data</button>
        </form>
      </div>
      <div style="overflow-x: auto">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.86rem">
          <thead>
            <tr style="text-align: left; color: var(--ss-muted)">
              <th style="padding: 8px 6px">Market</th>
              <th style="padding: 8px 6px">Newest cached month</th>
              <th style="padding: 8px 6px">Last fetch</th>
            </tr>
          </thead>
          <tbody>
            {markets.map((m) => (
              <tr style="border-top: 1px solid var(--ss-border, #e5e7eb)">
                <td style="padding: 8px 6px">{m.label}</td>
                <td style="padding: 8px 6px">{m.months[0] ? monthLabel(m.months[0]) : "—"}</td>
                <td style={`padding: 8px 6px; ${m.attempt && !m.attempt.ok ? "color: var(--ss-warn-ink, #b45309)" : ""}`}>
                  {m.attempt ? `${fmt(m.attempt.at)} — ${m.attempt.ok ? "ok" : m.attempt.error}` : "never"}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="field-hint" style="margin-top: 10px">
        Fetched on demand when a market update is created, at most once a day per market until the board publishes. Refresh forces a
        fetch now and overwrites the cached month; existing reports keep their frozen copy.
      </p>
    </section>
    {
      orders.length > 0 && (
        <section class="panel" style="margin-top: 24px">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Listing websites</p>
              <h2 style="display: flex; align-items: center; gap: 10px">
                Orders
                <span class="pill">{orders.filter((o) => o.state === "paid").length} paid</span>
              </h2>
            </div>
          </div>
          <div style="overflow-x: auto">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.86rem">
              <thead>
                <tr style="text-align: left; color: var(--ss-muted)">
                  <th style="padding: 8px 6px">Reference</th>
                  <th style="padding: 8px 6px">Client</th>
                  <th style="padding: 8px 6px">Page</th>
                  <th style="padding: 8px 6px">State</th>
                  <th style="padding: 8px 6px">Paid</th>
                  <th style="padding: 8px 6px">CRM</th>
                  <th style="padding: 8px 6px">Pending</th>
                  <th style="padding: 8px 6px" />
                </tr>
              </thead>
              <tbody>
                {orders.map((order) => {
                  const pending = pendingOperations(order);
                  return (
                    <tr style="border-top: 1px solid var(--ss-border, #e5e7eb)">
                      <td style="padding: 8px 6px; font-family: ui-monospace, monospace">{order.id}</td>
                      <td style="padding: 8px 6px">{order.client_slug}</td>
                      <td style="padding: 8px 6px">
                        <a href={order.page_url}>/{order.route}</a>
                      </td>
                      <td style="padding: 8px 6px">{order.state}</td>
                      <td style="padding: 8px 6px">{fmt(order.payment.paid_at)}</td>
                      <td style="padding: 8px 6px; font-family: ui-monospace, monospace">{order.fulfillment.crm_record_id || "—"}</td>
                      <td style="padding: 8px 6px; color: var(--ss-warn-ink, #b45309)">{pending.join("; ") || ""}</td>
                      <td style="padding: 8px 6px; white-space: nowrap">
                        {pending.length > 0 && (
                          <form method="post" action="/api/order-admin" style="display: inline">
                            <input type="hidden" name="order_id" value={order.id} />
                            <input type="hidden" name="action" value="retry" />
                            <button type="submit" class="button secondary sm">Retry</button>
                          </form>
                        )}
                        {(order.state === "paid" || order.state === "draft") && (
                          <form method="post" action="/api/order-admin" style="display: inline; margin-left: 6px">
                            <input type="hidden" name="order_id" value={order.id} />
                            <input type="hidden" name="action" value="cancel" />
                            <button type="submit" class="button ghost sm">Mark cancelled</button>
                          </form>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="field-hint" style="margin-top: 10px">Production stages live in Zoho CRM. This panel only shows payment and fulfilment; Retry re-runs the CRM record and the confirmation email for a paid order.</p>
        </section>
      )
    }
  </main>

  <Toast message={flash} />

  <script>
    const search = document.querySelector(
      "[data-client-search]"
    ) as HTMLInputElement | null;
    if (search) {
      const cards = Array.from(
        document.querySelectorAll("[data-client-grid] .ccard")
      ) as HTMLElement[];
      search.addEventListener("input", () => {
        const q = search.value.trim().toLowerCase();
        for (const card of cards) {
          const name = (card.dataset.clientName ?? "").toLowerCase();
          card.style.display = !q || name.includes(q) ? "" : "none";
        }
      });
    }
  </script>
</AppLayout>
